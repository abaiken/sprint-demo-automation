# Copy this file to .env and fill in what you need.
# Blank values fall back to the defaults in config.py.

# Optional path to a TOML config file (overrides this file for matching keys).
SPRINT_DEMO_CONFIG_PATH=

# ---------------------------------------------------------------------------
# Google transport
# ---------------------------------------------------------------------------
# auto (default): use "api" when SPRINT_DEMO_GOOGLE_CREDENTIALS_PATH or
#                 SPRINT_DEMO_GOOGLE_TOKEN_PATH points at an existing file,
#                 otherwise "gws" when the gws CLI is on PATH, otherwise "api".
# gws:            always shell out to the gws CLI. Let it own Google auth.
# api:            always use the Google API Python client
#                 (requires `pip install -e ".[api]"`).
SPRINT_DEMO_GOOGLE_BACKEND=auto

# --- Ignored when SPRINT_DEMO_GOOGLE_BACKEND=gws ---------------------------
# Used only by the Google API Python client backend. With the "gws" backend
# these are never read, so leave them blank. With "auto" they are not required
# either: they are only checked to decide whether to pick the api backend.
# SPRINT_DEMO_GOOGLE_CREDENTIALS_PATH=/absolute/path/to/credentials.json
# SPRINT_DEMO_GOOGLE_TOKEN_PATH=/absolute/path/to/google_token.json

# --- Read by the gws CLI itself, not by this project ----------------------
# Ignored by the api backend. Leave all three unset to use the credentials
# saved by `gws auth login -s drive,slides,calendar,sheets` (~/.config/gws).
# GOOGLE_WORKSPACE_CLI_TOKEN=
# GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE=
# GOOGLE_WORKSPACE_CLI_CONFIG_DIR=

# ---------------------------------------------------------------------------
# Source deck (use the ID or the URL form, not both)
# ---------------------------------------------------------------------------
SPRINT_DEMO_SOURCE_DRIVE_FOLDER_ID=
SPRINT_DEMO_SOURCE_DRIVE_FOLDER_URL=
SPRINT_DEMO_SOURCE_PRESENTATION_ID=
SPRINT_DEMO_SOURCE_PRESENTATION_URL=

# ---------------------------------------------------------------------------
# Destination folder for the generated deck (ID or URL; defaults to source)
# ---------------------------------------------------------------------------
SPRINT_DEMO_DESTINATION_DRIVE_FOLDER_ID=
SPRINT_DEMO_DESTINATION_DRIVE_FOLDER_URL=

# ---------------------------------------------------------------------------
# Hire dates
# ---------------------------------------------------------------------------
# Local CSV. Use this OR the Google Sheet values below.
SPRINT_DEMO_DEFAULT_HIRE_DATES_CSV=

# Google Sheet source (works with either Google backend). Leave the range blank
# to auto-detect the first sheet.
SPRINT_DEMO_HIRE_DATES_SHEET_ID=
SPRINT_DEMO_HIRE_DATES_SHEET_URL=
SPRINT_DEMO_HIRE_DATES_SHEET_RANGE=
# Team order (optional comma-separated presenter order)
SPRINT_DEMO_TEAM_ORDER=

# ---------------------------------------------------------------------------
# Slack (only needed for the Slack lookup and notification commands)
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
